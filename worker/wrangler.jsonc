{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bodyatlas",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-10",
  "compatibility_flags": ["nodejs_compat"],
  "vars": { "PUBLIC_SITE": "false" },
  "routes": [{ "pattern": "bodyatlas.okdtsk.dev", "custom_domain": true }],
  "workers_dev": true,
  "assets": {
    "directory": "./public-stub",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/auth/*",
      "/mcp",
      "/mcp/*",
      "/authorize",
      "/token",
      "/register",
      "/.well-known/oauth-authorization-server",
      "/.well-known/oauth-protected-resource",
      "/.well-known/oauth-protected-resource/*",
      "/robots.txt"
    ]
  },
  "durable_objects": {
    "bindings": [{ "name": "BODYATLAS_MCP", "class_name": "BodyAtlasMCP" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BodyAtlasMCP"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bodyatlas",
      "database_id": "ef3453cf-d3cc-42ac-853e-e2e78af633c0",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    { "binding": "SESSIONS", "id": "e25c68f7159e4ebaa11c04c3df74721f" },
    { "binding": "OAUTH_KV", "id": "6d97de780b8143fe9f7f472d93cea067" }
  ],
  "ratelimits": [
    { "name": "RL_API", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
    { "name": "RL_AI", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_AUTH", "namespace_id": "1003", "simple": { "limit": 20, "period": 60 } },
    { "name": "RL_MCP", "namespace_id": "1004", "simple": { "limit": 60, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
