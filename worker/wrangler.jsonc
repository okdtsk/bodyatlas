{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bodyatlas",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-10",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "bodyatlas.okdtsk.dev", "custom_domain": true }],
  "assets": {
    "directory": "./public-stub",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bodyatlas",
      "database_id": "ef3453cf-d3cc-42ac-853e-e2e78af633c0",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [{ "binding": "SESSIONS", "id": "e25c68f7159e4ebaa11c04c3df74721f" }],
  "observability": { "enabled": true }
}
